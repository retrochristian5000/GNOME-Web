using Gtk 4.0;
using Adw 1;

template $EphyDownloadWidget: Adw.ActionRow {
  [prefix]
  Image icon {}

  body: ProgressBar progress {
    pulse-step: 0.05;
  };

  [suffix]
  Button action_button {
    valign: center;
    clicked => $widget_action_button_clicked_cb() swapped;

    styles [
      "flat",
    ]
  }

  DragSource {
    actions: copy;
    prepare => $download_drag_prepare() swapped;
  }
}