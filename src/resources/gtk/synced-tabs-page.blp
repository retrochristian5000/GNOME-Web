using Gtk 4.0;
using Adw 1;

template $EphySyncedTabsPage: Adw.NavigationPage {
  title: _("Synced Tabs");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      description: _(
        "Below are the synced open tabs of your other devices that use Firefox Sync with this account. Open a tab by double clicking its name (tabs under Local Tabs cannot be opened)."
      );

      Adw.PreferencesGroup tabs_preferences_group {}
    };
  };
}
