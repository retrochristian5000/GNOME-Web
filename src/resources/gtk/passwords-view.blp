using Gtk 4.0;
using Adw 1;

template $EphyPasswordsView: $EphyDataView {
  search-description: _("Search passwords");
  empty-title: _("No Passwords");
  empty-description: _("Saved passwords will be listed here");
  can-clear: "True";
  clear-button: clear_button;
  notify::search-text => $on_search_text_changed() swapped;

  [top-start]
  ToggleButton edit_button {
    icon-name: "document-edit-symbolic";
    tooltip-text: _("Edit");
    sensitive: false;
    clicked => $on_edit_button_toggled();
  }

  [top-end]
  Button {
    icon-name: "view-sidebar-end-symbolic";
    tooltip-text: _("Close");
    action-name: "win.sidebar";
  }

  [top-end]
  MenuButton {
    icon-name: "view-more-symbolic";
    tooltip-text: _("Options");
    menu-model: options_menu;
  }

  Box {
    orientation: vertical;

    ScrolledWindow {
      vexpand: true;

      Adw.Clamp {
        margin-start: 6;
        margin-end: 6;

        ListBox listbox {
          margin-top: 6;
          margin-bottom: 6;
          valign: start;
          selection-mode: none;
          activate-on-single-click: false;

          styles [
            "boxed-list",
          ]
        }
      }
    }
  }

  [bottom-end]
  Button remove_button {
    label: _("_Remove");
    use-underline: true;
    tooltip-text: _("Remove Selected Passwords");
    clicked => $on_remove_button_clicked();

    styles [
      "destructive-action",
    ]
  }

  [bottom-end]
  Button clear_button {
    label: _("_Clear All");
    use-underline: true;
    tooltip-text: _("Remove All Passwords");
    clicked => $on_clear_button_clicked() swapped;

    styles [
      "destructive-action",
    ]
  }
}

menu treeview_popup_menu_model {
  section {
    item {
      label: _("_Copy Password");
      action: "passwords.copy-password";
    }

    item {
      label: _("C_opy Username");
      action: "passwords.copy-username";
    }
  }
}

menu options_menu {
  section {
    item {
      label: _("_Import…");
      action: "app.import-passwords";
    }

    item {
      label: _("_Export…");
      action: "app.export-passwords";
    }
  }
}
