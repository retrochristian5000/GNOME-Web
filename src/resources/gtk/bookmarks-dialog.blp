using Gtk 4.0;
using Adw 1;

template $EphyBookmarksDialog: Adw.Bin {
  Adw.ToolbarView toolbar_view {
    bottom-bar-style: raised;

    [top]
    Adw.HeaderBar {
      show-title: false;

      [start]
      ToggleButton search_button {
        icon-name: "edit-find-symbolic";
        active: bind search_bar.search-mode-enabled bidirectional;
        tooltip-text: _("Search");
        visible: bind $is_not_empty_state(toplevel_stack.visible-child-name);
      }

      [start]
      ToggleButton edit_button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Edit");
        visible: bind $is_not_empty_state(toplevel_stack.visible-child-name);
        toggled => $on_edit_button_toggled();
      }

      [end]
      Button close_button {
        icon-name: "view-sidebar-end-symbolic";
        tooltip-text: _("Close");
        action-name: "win.sidebar";
      }

      [end]
      MenuButton options_menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Options");
        menu-model: options_menu;
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: false;
      key-capture-widget: template;
      notify::search-mode-enabled => $on_search_mode_changed();

      Adw.Clamp {
        hexpand: true;

        SearchEntry search_entry {
          placeholder-text: _("Search bookmarks");
          search-changed => $on_search_entry_changed();

          EventControllerKey {
            key-pressed => $on_search_entry_key_pressed();
          }
        }
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Box {
        orientation: vertical;
        spacing: 12;
        margin-start: 6;
        margin-end: 6;
        margin-top: 6;
        margin-bottom: 6;

        Box {
          valign: start;
          orientation: vertical;
          spacing: 12;

          ScrolledWindow {
            propagate-natural-height: true;

            styles [
              "undershoot-top",
            ]

            child: Stack toplevel_stack {
              vhomogeneous: false;
              interpolate-size: true;
              hexpand: true;

              StackPage {
                name: "default";

                child: ListBox bookmarks_list_box {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]

                  GestureClick {
                    button: 0;
                    released => $row_clicked_cb();
                  }
                };
              }

              StackPage {
                name: "searching_bookmarks";

                child: ListBox searching_bookmarks_list_box {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]

                  GestureClick {
                    button: 0;
                    released => $row_clicked_cb();
                  }
                };
              }

              StackPage {
                name: "tag_detail";

                child: Box {
                  orientation: vertical;
                  spacing: 6;

                  CenterBox {
                    start-widget: Button tag_detail_back_button {
                      action-name: "dialog.tag-detail-back";
                      icon-name: "go-previous-symbolic";
                      margin-start: 6;
                      margin-end: 6;

                      styles [
                        "flat",
                      ]
                    };

                    center-widget: Label tag_detail_label {
                      styles [
                        "heading",
                      ]

                      ellipsize: end;
                      max-width-chars: 0;
                      hexpand: true;
                    };
                  }

                  ListBox tag_detail_list_box {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]

                    GestureClick {
                      button: 0;
                      released => $row_clicked_cb();
                    }
                  }
                };
              }

              StackPage {
                name: "no-results";

                child: Adw.StatusPage {
                  icon-name: "edit-find-symbolic";
                  title: _("No Results Found");
                  description: _("Try a different search");
                };
              }

              StackPage {
                name: "empty-state";

                child: Adw.StatusPage {
                  icon-name: "ephy-starred-symbolic";
                  title: _("No Bookmarks");
                  description: _("Bookmarked pages will appear here");
                };
              }
            };
          }
        }
      };
    };
  }
}

menu options_menu {
  section {
    item {
      label: _("I_mport…");
      action: "app.import-bookmarks";
    }

    item {
      label: _("E_xport…");
      action: "app.export-bookmarks";
    }
  }
}
