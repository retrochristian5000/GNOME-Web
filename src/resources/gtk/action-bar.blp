using Gtk 4.0;
using Adw 1;

template $EphyActionBar: Adw.Bin {
  Box toolbar {
    homogeneous: true;

    styles [
      "toolbar",
    ]

    Button navigation_back {
      action-name: "toolbar.navigation-back";
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Back");

      styles [
        "toolbar-button",
      ]

      GestureClick {
        button: 2;
        pressed => $middle_click_pressed_cb();
        released => $middle_click_released_cb();
      }

      GestureClick {
        button: 3;
        pressed => $right_click_pressed_cb();
      }

      GestureLongPress {
        pressed => $long_pressed_cb();
      }
    }

    Button navigation_forward {
      action-name: "toolbar.navigation-forward";
      icon-name: "go-next-symbolic";
      tooltip-text: _("Forward");

      styles [
        "toolbar-button",
      ]

      GestureClick {
        button: 2;
        pressed => $middle_click_pressed_cb();
        released => $middle_click_released_cb();
      }

      GestureClick {
        button: 3;
        pressed => $right_click_pressed_cb();
      }

      GestureLongPress {
        pressed => $long_pressed_cb();
      }
    }

    $EphySiteMenuButton site_menu_button {
      visible: false;
    }

    Adw.TabButton tab_button {
      action-name: "win.tabs-view";
    }

    $EphyPageMenuButton {}

    Button sidebar_button {
      tooltip-text: _("Sidebar");
      action-name: "win.sidebar";

      child: Image sidebar_icon {
        icon-name: "view-sidebar-end-symbolic";
        valign: center;
      };

      styles [
        "toolbar-button",
      ]
    }
  }
}
