using Gtk 4.0;
using Adw 1;

menu overview_menu {
  section {
    item {
      label: _("_New Window");
      action: "app.new-window";
    }

    item {
      label: _("New _Incognito Window");
      action: "app.new-incognito";
    }
  }

  section {
    item {
      label: _("Reopen Closed _Tab");
      action: "app.reopen-closed-tab";
    }

    item {
      label: _("Close _All Tabs");
      action: "app.close-all-tabs";
    }
  }
}

template $EphyWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 200;
  notify::fullscreened => $notify_fullscreen_cb();

  /* While vertical tabs are on, ephy-window.c raises this condition to
   * 682sp, like Nautilus: the tab sidebar needs its own room. */
  Adw.Breakpoint narrow_breakpoint {
    condition ("max-width: 600px")

    setters {
      template.adaptive-mode: EPHY_ADAPTIVE_MODE_NARROW;
    }
  }

  content: Adw.OverlaySplitView overlay_split_view {
    max-sidebar-width: 360;
    collapsed: true;
    show-sidebar: false;
    sidebar-position: end;
    notify::show-sidebar => $show_sidebar_cb() swapped;

    content: Adw.TabOverview overview {
      enable-new-tab: true;
      secondary-menu: overview_menu;
      notify::open => $notify_overview_open_cb() swapped;
      create-tab => $create_tab_cb() swapped;

      child: Adw.OverlaySplitView tab_split_view {
        show-sidebar: false;
        enable-show-gesture: false;
        enable-hide-gesture: false;
        sidebar-width-fraction: 0.2;

        sidebar: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-title: false;

            [end]
            Button {
              icon-name: "view-grid-symbolic";
              action-name: "win.tabs-view";
              tooltip-text: _("View Open Tabs");

              styles [
                "toolbar-button",
              ]
            }
          }

          content: $EphyTabSidebar tab_sidebar {
            create-tab => $create_tab_cb() swapped;
          };
        };

        content: $EphyFullscreenBox fullscreen_box {
          [top]
          Adw.Bin header_bin_top {
            child: $EphyHeaderBar header_bar {};
          }

          [top]
          Adw.Bin tab_bar_bin {
            child: Adw.TabBar tab_bar {};
          }

          Adw.ToastOverlay toast_overlay {
            child: $EphyTabView tab_view {
              EventControllerScroll { // Hides action bar during scrolling
                propagation-phase: capture;
                flags: vertical;
                scroll => $scroll_cb() swapped;
              }
            };
          }

          [bottom]
          Adw.Bin header_bin_bottom {}

          [bottom]
          Revealer action_bar_revealer {
            visible: false;
            reveal-child: false;

            child: $EphyActionBar action_bar {};
          }
        };
      };
    };

    sidebar: $EphyBookmarksDialog bookmarks_dialog {};
  };

  GesturePan {
    orientation: vertical;
    propagation-phase: capture;
    pan => $pan_cb() swapped;
  }

  ShortcutController bubble_shortcut_controller {
    propagation-phase: bubble;
    scope: local;
  }
}